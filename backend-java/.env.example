# Server Configuration
PORT=5000

# MongoDB Connection (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/dineflow
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/dineflow?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=dineflow-super-secret-jwt-key-must-be-at-least-256bits-long-for-hs256
JWT_EXPIRE=604800000

# Twilio Configuration (Optional - runs in mock mode if omitted)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Frontend / CORS URL
FRONTEND_URL=http://localhost:5173
